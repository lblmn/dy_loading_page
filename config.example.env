# LinkLab 运行配置示例
# 用法：复制本文件为 .env，按实际环境修改；start.sh / start.bat 会自动加载。
# 也可以不建 .env，直接在系统/容器里设置同名环境变量（容器部署推荐这种做法）。
# 所有变量均以 LINKLAB_ 开头，未设置的项使用代码内默认值。

# ---------- 监听 ----------
# 默认 127.0.0.1 只能本机访问。服务器部署必须改成 0.0.0.0，
# 并且用 Nginx / Caddy 终止 HTTPS 后反向代理到本机端口。
LINKLAB_HOST=127.0.0.1
LINKLAB_PORT=8787

# ---------- 对外地址（强烈建议显式设置）----------
# 决定生成出来的短链 / 二维码里用的域名。不设置时会取请求 Host 头，
# 反代配置不当时会生成错误域名，也可能被伪造 Host 头污染。
LINKLAB_PUBLIC_BASE_URL=

# ---------- HTTPS / Cookie ----------
# 前置 HTTPS 反代后设为 1，会话 Cookie 会带上 Secure 标志。
# 注意：本机用 http 直连时不要开，否则浏览器不会回传 Cookie。
LINKLAB_SECURE_COOKIE=0

# ---------- 初始管理员密码 ----------
# 首次启动（数据库为空）时生效。留空则随机生成并在控制台打印一次。
# 建议用 16 位以上随机串；部署后请登录 /admin 立即修改。
LINKLAB_ADMIN_PASSWORD=

# ---------- 开发 / 生产开关 ----------
# 千万别在生产开！开启后会写入固定演示账号 admin/admin123、student/student123，
# 登录页也会显示这些凭据。仅用于本地开发和跑 smoke_test.py。
LINKLAB_DEV_MODE=0

# ---------- 安全参数 ----------
# 同一 IP + 用户名在窗口期内允许的失败登录次数，超出返回 429
LINKLAB_LOGIN_MAX_ATTEMPTS=5
LINKLAB_LOGIN_WINDOW=60
# 新建账号 / 重置密码的最小口令长度
LINKLAB_MIN_PASSWORD_LENGTH=8
# 会话有效期（天）
LINKLAB_SESSION_DAYS=7
# 一号一设备强制绑定（默认关闭，开启后换浏览器需管理员在后台解绑）
# 注意：设备码由浏览器自报，仅用于演示级约束，不是密码学强绑定。
LINKLAB_STRICT_DEVICE_BINDING=0

# ---------- 落地行为 ----------
# 网页地址类型的自动跳转倒计时（秒）。0 = 不自动跳转，只显示手动按钮。
# 自动跳转带可见倒计时且可取消，用户始终保留手动选择权。
LINKLAB_AUTO_FORWARD_SECONDS=3

# 应用链接白名单：只有你自己拥有或已获授权的应用才允许被唤起。
# 逗号分隔的前缀列表，例如 https://yourapp.example.com/ ，myapp://
# 留空则禁用「应用链接」类型，杜绝写入未授权的第三方协议。
# 该类型（app）必须由用户主动点击才会唤起，系统不会静默拉起应用。
LINKLAB_APP_LINK_ALLOWLIST=

# 第三方 App 深链（原站模式）：1 开启 / 0 关闭。
# 开启后「视频深链 / 直播深链」两种目标类型可用：
#   主版 snssdk1128://aweme/push_detail?item_id=..&hot=feed&cold=feed&gids=..
#   极速版 snssdk2329://（落地类型选「App 极速版」）
#   直播 snssdk1128://live?room_id=..
# 关闭后服务端不生成任何第三方协议，深链类型退化为「仅展示配置」。
LINKLAB_DEEP_LINKS=1

# 视频深链队尾垫底：实测抖音 push_detail 的 gids 末项会被播放，但只有用户 ID 时
# 末位会回落推荐流（N 个只有前 N-1 个正常）。服务端在深链 gids 末尾追加一个
# 「不存在的错误 ID」占住末位：抖音取不到内容，该位置回落推荐流（末位随机播放），
# 客户的全部真实 ID 正常播放。不进展示列表、不参与洗牌。
# 1 开启 / 0 关闭；垫底 ID 池（逗号分隔，按序取第一个与队列不重复的）。
LINKLAB_GID_PAD=1
LINKLAB_GID_PAD_IDS=9999999999999999999

# 落地页自动拉起前的延时（毫秒，原站为 260）。0 = 只给手动按钮、不自动拉起。
# 检测到微信等内置浏览器 UA 时自动拉起暂停，并提示「在浏览器中打开」。
LINKLAB_FORCE_LAUNCH_MS=260

# 把 utm_* / channel / ref / from 渠道参数透传到自有网页目标，并记入点击报表。
LINKLAB_UTM_PASSTHROUGH=1

# ---------- 分享短链自动解析 ----------
# 粘贴 v.douyin.com 等分享短链（第 1 个目标、第 2~5 个 ID、更多 ID、批量列表、
# 直播间均生效）时，由服务端跟随重定向取真实视频 ID / 房间号；已是纯 ID 不转换。
# 关闭后短链解析不出 ID 会直接报错，而不是把 URL 当 ID 存库。
LINKLAB_RESOLVE_SHORT_LINKS=1
# 单次短链解析超时秒数
LINKLAB_RESOLVE_TIMEOUT=6

# ---------- 落地页品牌化（可选）----------
# 名称：显示在落地页标题与眉标；LOGO：仅接受 /static/ 下的本地相对路径；
# 颜色：#rrggbb，用作强调色；公告：显示在「关于这个入口」下方。
LINKLAB_BRAND_NAME=LinkLab
LINKLAB_BRAND_LOGO=
LINKLAB_BRAND_COLOR=
LINKLAB_BRAND_NOTICE=

# ---------- 运维 ----------
# 逐请求访问日志，生产可关掉减少 IO
LINKLAB_LOG_REQUESTS=1
# 反代后如需按 X-Forwarded-For 做登录限流才开启；直连时勿开（该头可伪造）
LINKLAB_TRUST_PROXY=0
# 数据库路径，默认在程序同目录的 linklab.db；容器部署可挂到数据卷
# LINKLAB_DB=/data/linklab.db
